{
  "name": "fieldday",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @fieldday/web dev",
    "dev:server": "pnpm --filter @fieldday/server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @fieldday/web e2e",
    "assets": "bash scripts/prepare-assets.sh"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
